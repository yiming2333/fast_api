# 复制为 .env 并按需修改；.env 已在 .gitignore 中，不会被提交
# ===== 应用 =====
APP_NAME=我的 API
APP_DESCRIPTION=这是一个示例 API，展示文档自定义功能
APP_VERSION=1.0.0
DEBUG=false

# ===== API 版本前缀 =====
API_V1_PREFIX=/api/v1

# ===== CORS（JSON 数组形式） =====
CORS_ORIGINS=["http://localhost:8000","http://localhost:8080"]

# ===== JWT（生产务必替换为强随机值，例如 openssl rand -hex 32） =====
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== 数据库 =====
# 方式一：直接给完整 URL（覆盖下面所有 DB_* 字段）
# DB_URL=mysql+aiomysql://user:password@127.0.0.1:3306/fast_api?charset=utf8mb4

# 方式二：按字段拼接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=fast_api

# ===== 上传目录 =====
UPLOAD_DIR=uploads
